# ─────────────────────────────────────────────────────────────────────
# AI Agents — Root environment file (example)
#
# Copy to `.env` and fill in values for local development, or use this
# as a reference for the variables consumed across all agents, the
# Slack bot, and the deployment manifests (Helm / Kubernetes).
#
#   cp .env.example .env
#
# For production on Kubernetes, prefer a Secret managed by External
# Secrets Operator, Sealed Secrets, or a vault provider — do NOT commit
# real values to this file.
# ─────────────────────────────────────────────────────────────────────

# ── LLM provider ─────────────────────────────────────────────────────
# Supported providers via `core/orrery_core/agent/base.py::resolve_model`:
#   gemini (default) | anthropic | openai | ollama
MODEL_PROVIDER=gemini
MODEL_NAME=gemini-3.6-flash
GEMINI_MODEL_VERSION=gemini-3.6-flash

# ── Google AI Studio (default path for Gemini) ───────────────────────
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=

# ── Vertex AI (alternative to AI Studio) ─────────────────────────────
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1

# ── Anthropic / OpenAI / Ollama (via LiteLLM) ────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# OLLAMA_API_BASE=http://localhost:11434

# ── Session & memory storage ─────────────────────────────────────────
# The platform supports two stores: in-memory (no DATABASE_URL) or
# PostgreSQL (DATABASE_URL set). SQLite is not supported. Without
# DATABASE_URL, sessions and long-term memory live in-memory and are lost
# on restart; set a PostgreSQL DATABASE_URL to persist them (required for
# multi-replica deployments). Example (dockerized Postgres via localhost):
#   DATABASE_URL=postgresql+asyncpg://agents:agents_secret@localhost:5432/agents
#
# Default PostgreSQL credentials used in docker-compose.yml:
POSTGRES_USER=agents
POSTGRES_PASSWORD=agents_secret
POSTGRES_DB=agents

# Example (async driver recommended for the Slack bot):
#   postgresql+asyncpg://agents:agents_secret@postgres:5432/agents
# DATABASE_URL=

# ── Confirmation store (pending approvals for guarded tools) ─────────
# One platform-wide store shared by every transport: the HTTP front door /
# persistent runner (strict mode), the Google Chat bot (approval cards), and
# the Slack bot (Approve/Deny buttons). "memory" (default) is process-local —
# single replica only, and a pending dies with the pod; "postgres" shares the
# approval handshake across replicas and survives restarts (uses
# DATABASE_URL). Required whenever any of these transports scales past one
# replica.
# ORRERY_CONFIRMATION_BACKEND=memory

# Per-caller rate limit on POST /chat (slowapi syntax: "30/minute", "5/second").
# Keyed on the verified JWT subject, not the source address — behind an ingress
# every caller shares an IP. A turn buys LLM tokens and can fan out to every
# specialist plus a triage sweep, so this is the ceiling on what one credential
# can spend.
# ORRERY_CHAT_RATE_LIMIT=30/minute

# Per-caller rate limit on POST /onboarding/selftest — the console's
# "Check my environment" button. The checks are read-only and cheap, but they
# do reach out to every configured integration and spend one model token.
# ORRERY_SELFTEST_RATE_LIMIT=10/minute

# Serve FastAPI's interactive schema at /docs. Unset means "on only when
# AUTH_ENABLED=false": a browser navigation cannot carry a bearer token, so the
# page cannot be gated behind the API's own auth, and it enumerates every route
# and request shape. Useful locally, free reconnaissance in production.
# ORRERY_DOCS_ENABLED=false

# Worker threads for the blocking tool layer (Kubernetes/Kafka/HTTP/Docker
# clients, all offloaded from the event loop). Computed from the container's
# cgroup CPU quota by default — asyncio's own default is derived from the
# *host* core count, which in a pod means nothing. Set only to override.
# ORRERY_MAX_WORKER_THREADS=

# Protected namespaces: a comma-separated list of globs naming namespaces
# where only `admin` may run a mutating tool. RBAC decides *which* tool a role
# may call; this decides *where* — an operator who legitimately restarts an
# application Deployment has no business restarting one in kube-system. Reads
# are never scoped (diagnosis needs to see infrastructure namespaces). The
# effective namespace comes from the call's argument, or the tool's own
# default when omitted; a call whose namespace can't be resolved is refused.
# Unset (the default) leaves the guard inert.
# ORRERY_PROTECTED_NAMESPACES=kube-system,kube-public,kube-node-lease,monitoring*

# ── Runtime security hardening (AEP-013) ─────────────────────────────
# Prompt-injection screen, both directions. Inbound: blocks messages matching
# overt override phrasings ("ignore previous instructions", "reveal your system
# prompt", ...) before the model runs. Outbound: the same patterns are matched
# against tool results — a pod annotation, log line or k8s event an attacker can
# write reaches the model wearing a tool's authority — and matched spans are
# replaced in place rather than dropping the payload, since that payload is the
# evidence being diagnosed. On by default; this flag disables both.
# ORRERY_SAFETY_SCREEN=true
#
# PII/secret redaction: scrubs credentials (password/token/api-key fields,
# PEM blocks, provider token shapes) from every tool result before the model,
# the session store, or the audit log sees them. On by default.
# ORRERY_PII_REDACTION=true
#
# Also redact IPv4 addresses from tool results. Off by default — an SRE agent
# that cannot see pod/broker IPs cannot diagnose much. Enable for
# compliance-bound deployments.
# ORRERY_REDACT_IPS=false
#
# Gemini content-safety filters (Gemini models only; LiteLLM providers are
# unaffected). On by default at BLOCK_ONLY_HIGH — stricter thresholds trip on
# legitimate ops chatter ("kill the pod", "destroy the volume").
# GEMINI_SAFETY_FILTERS=true
# GEMINI_SAFETY_THRESHOLD=BLOCK_ONLY_HIGH

# ── Observability ────────────────────────────────────────────────────
ENABLE_METRICS_SERVER=true
HEALTH_PORT=8080
METRICS_PORT=9100
LOG_LEVEL=INFO

# ── Distributed tracing (OpenTelemetry, AEP-010) ─────────────────────
# Requires the `otel` extra:  uv sync --extra otel
# When enabled, default_plugins(enable_tracing=True) installs a global
# TracerProvider and exports ADK's native agent/tool/LLM spans, enriched
# with orrery attributes (request_id, user_role, tool status, token usage).
# When OTEL_TRACING_ENABLED is unset/false this is a zero-overhead no-op.
OTEL_TRACING_ENABLED=false
# OTLP gRPC collector endpoint. With the local stack (`make tracing-up`)
# Tempo listens on :4317. Leave empty to print spans to the console (dev).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# Resource service.name attribute attached to every span.
OTEL_SERVICE_NAME=orrery
# Head-sampling ratio (0.0–1.0). 1.0 samples every trace; lower it under
# high load. ParentBased — an upstream sampled trace is always kept.
OTEL_TRACES_SAMPLER_ARG=1.0

# ── Context caching (Gemini only) ────────────────────────────────────
CONTEXT_CACHE_MIN_LENGTH=2048
CONTEXT_CACHE_TTL_SECONDS=600
CONTEXT_CACHE_INTERVALS=10

# ── Context compaction (on by default) ───────────────────────────────
# Replaces older turns with an LLM digest once a session's prompt passes the
# threshold, so a long incident session can't grow past the model's window.
# Lossless for the record: originals stay in the session store and are filtered
# out only when the request is assembled, so audit and replay are unaffected.
# The default threshold is out of reach for ordinary sessions — set it far lower
# (e.g. 2000) only to exercise the path locally.
ORRERY_CONTEXT_COMPACTION=true
ORRERY_COMPACTION_TOKEN_THRESHOLD=250000
ORRERY_COMPACTION_RETENTION_EVENTS=20
# Sliding-window backstop; ADK requires it, so it can't be disabled. Kept high
# enough that the token threshold above is normally the trigger that fires.
ORRERY_COMPACTION_INTERVAL=50
ORRERY_COMPACTION_OVERLAP=2
# Digests are plumbing, not user-facing reasoning — run them on a cheap model.
# On non-Gemini providers this falls back to MODEL_NAME; set it explicitly.
ORRERY_COMPACTION_MODEL=gemini-flash-latest

# ── Planning (opt-in, off by default) ────────────────────────────────
# Attaches an ADK planner to the reasoning-heavy agents in
# orrery-assistant: root orchestrator, triage_summarizer, remediation_actor.
# Tool-leaf agents (per-system health checkers, remediation verifier,
# journal writer) intentionally skip the planner.
#
#   none        — no planner (default; zero behavior change)
#   plan_react  — provider-agnostic; structures output into PLANNING /
#                 ACTION / REASONING / FINAL_ANSWER phases. Works with
#                 Gemini, Claude, OpenAI, and Ollama via LiteLLM.
#   builtin     — Gemini's native thinking tokens (BuiltInPlanner). Falls
#                 back to no planner with a warning when MODEL_PROVIDER
#                 is not gemini.
ORRERY_PLANNER=none
# Builtin-only knobs (consulted only when ORRERY_PLANNER=builtin):
# ORRERY_PLANNER_THINKING_BUDGET=1024
# ORRERY_PLANNER_INCLUDE_THOUGHTS=true

# ── Target infrastructure (agent tools connect to these) ─────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100
ALERTMANAGER_URL=http://localhost:9093

# ── Elasticsearch (only needed for agents/elasticsearch) ──────────────
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
# ELASTICSEARCH_API_KEY=
ELASTICSEARCH_VERIFY_CERTS=true
ELASTICSEARCH_HTTP_TIMEOUT=15
# ELASTICSEARCH_CA_CERTS=
# KUBECONFIG_PATH=

# ── Slack bot (only needed when running agents/slack-bot) ────────────
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APP_TOKEN=
SLACK_BOT_PORT=3000
# Per-IP rate limit for the /slack/events endpoint (slowapi syntax).
SLACK_RATE_LIMIT=60/minute
# Trusted reverse-proxy hops for rate-limiter IP resolution. Set to the
# number of proxies between the public internet and this process (e.g.
# 1 behind ingress-nginx, 2 behind ingress-nginx + a cloud LB). Leave 0
# when exposed directly — otherwise callers can spoof X-Forwarded-For
# and bypass the limit.
SLACK_TRUSTED_PROXY_HOPS=0
# Comma-separated Slack user IDs mapped to RBAC roles. Unlisted users
# default to "viewer".
SLACK_ADMIN_USERS=
SLACK_OPERATOR_USERS=

# ── Google Chat bot (only needed when running agents/google-chat-bot) 
# Token audience — for HTTP endpoints, must match your Chat app's 
# URL character-for-character, including the trailing slash.
GOOGLE_CHAT_AUDIENCE=https://your-bot.example.com/
# Comma-separated emails mapped to RBAC roles.
GOOGLE_CHAT_ADMIN_EMAILS=
GOOGLE_CHAT_OPERATOR_EMAILS=
# Auth verification (recommended for production).
GOOGLE_CHAT_VERIFY_TOKEN=true
# Comma-separated allowed service account emails.
# Standard: chat@system.gserviceaccount.com
# Add-ons: service-<PROJECT_NUMBER>@gcp-sa-gsuiteaddons.iam.gserviceaccount.com
GOOGLE_CHAT_IDENTITIES=chat@system.gserviceaccount.com
# Approve/Deny buttons on confirmation cards. Only works on the HTTP
# endpoint transport; keep false on Pub/Sub (button clicks need a
# synchronous response a pull worker can't give — the card asks for a
# reply of 'approve'/'deny' in the thread instead).
GOOGLE_CHAT_INTERACTIVE_BUTTONS=false
# Pending-approval store: see ORRERY_CONFIRMATION_BACKEND above — one
# platform-wide setting shared by the Chat bot, Slack bot, and HTTP server.
# Async response mode. Set to true (default) for long-running agents.
# Webhook returns immediately and real reply is posted via REST API.
# This mode requires an identity with the 'https://www.googleapis.com/auth/chat.bot' scope.
GOOGLE_CHAT_ASYNC_RESPONSE=true
# Optional path to service account JSON for async mode. If unset, 
# Application Default Credentials (ADC) are used. Preferred method is 
# ADC (Workload Identity on GKE, or 'gcloud auth application-default login').
GOOGLE_CHAT_SERVICE_ACCOUNT_FILE=

# ── Pub/Sub transport (for private network / private GKE) ──
# Subscription identifier (short ID or full projects/.../subscriptions/... path).
GOOGLE_CHAT_PUBSUB_SUBSCRIPTION=
# GCP Project hosting the subscription (defaults to GOOGLE_CLOUD_PROJECT).
GOOGLE_CHAT_PUBSUB_PROJECT=
# Concurrent in-flight messages per pod.
GOOGLE_CHAT_PUBSUB_MAX_MESSAGES=4
# Per-message handler cap (seconds) before redelivery.
GOOGLE_CHAT_PUBSUB_HANDLER_TIMEOUT_SECONDS=600


# ── Security / Auth (AEP-013) ────────────────────────────────────────
# Authenticated HTTP front door (orrery_core.server). Required for any
# deployment that exposes the agent over plain HTTP — without these the
# RBAC roles encoded in the JWT are not verifiable and `adk web` style
# entry points trust the caller's self-declared identity.
#
# AUTH_ENABLED gates the whole layer. Leave at "true" for any non-dev
# environment. The Slack and Google Chat transports authenticate at
# their own layer and are unaffected by this flag.
AUTH_ENABLED=true
#
# JWT_ALGORITHM picks the verification path:
#   HS256                — symmetric. Set JWT_SECRET. Suitable for dev
#                          and for deployments where a trusted gateway
#                          mints tokens with a shared secret.
#   RS256 / ES256 / …    — asymmetric. Set JWT_JWKS_URL to your IdP's
#                          JWKS endpoint (Auth0, Keycloak, Okta, GCP IAP).
JWT_ALGORITHM=HS256
#
# Required for HS256. MUST be ≥32 bytes in production. In Kubernetes
# prefer mounting via a Secret and ORRERY_SECRETS_DIR rather than env vars.
JWT_SECRET=
#
# Required for RS256/ES256 (ignored for HS256). Standard discovery
# locations:
#   Auth0:    https://YOUR_TENANT.auth0.com/.well-known/jwks.json
#   Keycloak: https://KC/realms/REALM/protocol/openid-connect/certs
#   Google:   https://www.googleapis.com/oauth2/v3/certs
JWT_JWKS_URL=
#
# Strongly recommended: bind tokens to this service and its issuer.
# Tokens missing or mismatching these claims are rejected.
JWT_AUDIENCE=
JWT_ISSUER=
#
# Custom claim that carries the role list. Tokens issued by Auth0 RBAC
# typically use "https://example.com/roles" — adjust accordingly.
#
# May be a dotted path into nested claims. Keycloak nests realm roles, so a
# flat lookup finds nothing and silently downgrades every user to viewer:
#   JWT_ROLE_CLAIM=realm_access.roles
# The console's VITE_OIDC_ROLE_CLAIM must be set to the same value.
JWT_ROLE_CLAIM=roles
#
# Clock skew tolerance for `exp`/`nbf` validation (seconds).
JWT_LEEWAY_SECONDS=30
#
# CORS allowlist for browser clients of POST /chat (comma-separated).
# Leave empty to disable CORS.
ORRERY_CORS_ORIGINS=
#
# ── Web console SSO (build-time, read by Vite) ───────────────────────
# These are baked into the bundle by `npm run build`, not read at runtime.
# Leave VITE_OIDC_ISSUER unset to keep the paste-a-token gate (what CI and
# `make dev-token` use); set it to switch the console to OIDC Authorization
# Code + PKCE. Try it locally with: make sso-up && make run-console-sso
#
# VITE_OIDC_ISSUER=http://localhost:8081/realms/orrery
# VITE_OIDC_CLIENT_ID=orrery-console
# VITE_OIDC_SCOPE=openid profile email
# Must match JWT_ROLE_CLAIM above, or the badge disagrees with enforced RBAC.
# VITE_OIDC_ROLE_CLAIM=realm_access.roles
#
# Web console (AEP-019). When "true", the HTTP front door serves the built
# React SPA (from web/, bundled into serving/static at image build time) at "/".
# The static shell is public; the /chat API it calls stays JWT-protected.
# Off by default — a browser surface must not be exposed unintentionally.
ORRERY_WEB_CONSOLE_ENABLED=false
#
# Mounted-secrets directory. When set, SecretsManager reads any key as
# a file under this directory before falling back to env vars. Pair
# with a Kubernetes Secret volume so JWT_SECRET / API keys never appear
# in the pod's environment.
# ORRERY_SECRETS_DIR=/var/run/secrets/orrery

# ── K8s tooling ──────────────────────────────────────────────────────
# Most tools auto-load kubeconfig; set only if you need an override.
# KUBECONFIG=~/.kube/config

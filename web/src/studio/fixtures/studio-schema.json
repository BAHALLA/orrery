{
  "spec_version": 1,
  "spec": {
    "$defs": {
      "Budgets": {
        "additionalProperties": false,
        "description": "Whole-run limits (the composition ledger). Unset: the deployment's ceiling.",
        "properties": {
          "max_tokens": {
            "anyOf": [
              {
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Max Tokens"
          },
          "max_tool_calls": {
            "anyOf": [
              {
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Max Tool Calls"
          },
          "max_delegations": {
            "anyOf": [
              {
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Max Delegations"
          },
          "max_remote_calls": {
            "anyOf": [
              {
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Max Remote Calls"
          },
          "timeout_s": {
            "anyOf": [
              {
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Timeout S"
          }
        },
        "title": "Budgets",
        "type": "object"
      },
      "Edge": {
        "additionalProperties": false,
        "properties": {
          "from": {
            "pattern": "^[a-z][a-z0-9_]{0,30}$",
            "title": "From",
            "type": "string"
          },
          "to": {
            "pattern": "^[a-z][a-z0-9_]{0,30}$",
            "title": "To",
            "type": "string"
          },
          "when": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "When"
          },
          "max_iterations": {
            "anyOf": [
              {
                "maximum": 5,
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Max Iterations"
          },
          "screen": {
            "default": false,
            "title": "Screen",
            "type": "boolean"
          }
        },
        "required": ["from", "to"],
        "title": "Edge",
        "type": "object"
      },
      "HumanApprovalNode": {
        "additionalProperties": false,
        "description": "Pauses the run until the person who started it decides (P0c).\n\nIts answer is labelled ``approved`` or ``rejected`` (:data:`APPROVAL_LABELS`),\nso its edges are taken on those. An approved branch gets the text that\nwas reviewed; a rejected one gets the reviewer's comment and that text. A\nrejection with no edge for it ends the run ``rejected``.",
        "properties": {
          "id": {
            "description": "Unique in the spec; the compiled agent is n_<id>.",
            "pattern": "^[a-z][a-z0-9_]{0,30}$",
            "title": "Id",
            "type": "string"
          },
          "description": {
            "default": "",
            "maxLength": 500,
            "title": "Description",
            "type": "string"
          },
          "kind": {
            "const": "human_approval",
            "title": "Kind",
            "type": "string"
          },
          "prompt": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Prompt",
            "type": "string"
          }
        },
        "required": ["id", "kind", "prompt"],
        "title": "HumanApprovalNode",
        "type": "object"
      },
      "JoinNode": {
        "additionalProperties": false,
        "description": "Waits for every incoming branch (P0b).",
        "properties": {
          "id": {
            "description": "Unique in the spec; the compiled agent is n_<id>.",
            "pattern": "^[a-z][a-z0-9_]{0,30}$",
            "title": "Id",
            "type": "string"
          },
          "description": {
            "default": "",
            "maxLength": 500,
            "title": "Description",
            "type": "string"
          },
          "kind": {
            "const": "join",
            "title": "Kind",
            "type": "string"
          }
        },
        "required": ["id", "kind"],
        "title": "JoinNode",
        "type": "object"
      },
      "LlmAgentNode": {
        "additionalProperties": false,
        "description": "An Orrery agent (``create_agent()``): instruction, tools, optional model.",
        "properties": {
          "id": {
            "description": "Unique in the spec; the compiled agent is n_<id>.",
            "pattern": "^[a-z][a-z0-9_]{0,30}$",
            "title": "Id",
            "type": "string"
          },
          "description": {
            "default": "",
            "maxLength": 500,
            "title": "Description",
            "type": "string"
          },
          "kind": {
            "const": "llm_agent",
            "title": "Kind",
            "type": "string"
          },
          "instruction": {
            "maxLength": 8000,
            "minLength": 1,
            "title": "Instruction",
            "type": "string"
          },
          "tools": {
            "items": {
              "type": "string"
            },
            "maxItems": 20,
            "title": "Tools",
            "type": "array"
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Model"
          },
          "output": {
            "anyOf": [
              {
                "$ref": "#/$defs/NodeOutput"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": ["id", "kind", "instruction"],
        "title": "LlmAgentNode",
        "type": "object"
      },
      "NodeOutput": {
        "additionalProperties": false,
        "description": "What a node's answer is classified as, for labelled edges (P0b).",
        "properties": {
          "labels": {
            "items": {
              "pattern": "^[a-z][a-z0-9_]{0,30}$",
              "type": "string"
            },
            "maxItems": 10,
            "minItems": 2,
            "title": "Labels",
            "type": "array"
          }
        },
        "required": ["labels"],
        "title": "NodeOutput",
        "type": "object"
      },
      "ParallelNode": {
        "additionalProperties": false,
        "description": "Fans out to the nodes its edges name (P0b).",
        "properties": {
          "id": {
            "description": "Unique in the spec; the compiled agent is n_<id>.",
            "pattern": "^[a-z][a-z0-9_]{0,30}$",
            "title": "Id",
            "type": "string"
          },
          "description": {
            "default": "",
            "maxLength": 500,
            "title": "Description",
            "type": "string"
          },
          "kind": {
            "const": "parallel",
            "title": "Kind",
            "type": "string"
          }
        },
        "required": ["id", "kind"],
        "title": "ParallelNode",
        "type": "object"
      },
      "RemoteA2aNode": {
        "additionalProperties": false,
        "description": "Console shorthand: an llm_agent holding one remote skill and told to forward (P1).",
        "properties": {
          "id": {
            "description": "Unique in the spec; the compiled agent is n_<id>.",
            "pattern": "^[a-z][a-z0-9_]{0,30}$",
            "title": "Id",
            "type": "string"
          },
          "description": {
            "default": "",
            "maxLength": 500,
            "title": "Description",
            "type": "string"
          },
          "kind": {
            "const": "remote_a2a",
            "title": "Kind",
            "type": "string"
          },
          "remote": {
            "description": "<entry>.<skill>",
            "title": "Remote",
            "type": "string"
          },
          "instruction": {
            "default": "",
            "maxLength": 8000,
            "title": "Instruction",
            "type": "string"
          }
        },
        "required": ["id", "kind", "remote"],
        "title": "RemoteA2aNode",
        "type": "object"
      },
      "RouterNode": {
        "additionalProperties": false,
        "description": "Reads the previous node's output label and picks an outgoing edge (P0b).",
        "properties": {
          "id": {
            "description": "Unique in the spec; the compiled agent is n_<id>.",
            "pattern": "^[a-z][a-z0-9_]{0,30}$",
            "title": "Id",
            "type": "string"
          },
          "description": {
            "default": "",
            "maxLength": 500,
            "title": "Description",
            "type": "string"
          },
          "kind": {
            "const": "router",
            "title": "Kind",
            "type": "string"
          }
        },
        "required": ["id", "kind"],
        "title": "RouterNode",
        "type": "object"
      },
      "SupervisorNode": {
        "additionalProperties": false,
        "description": "An llm_agent whose children (llm_agent or supervisor nodes) are its tools.",
        "properties": {
          "id": {
            "description": "Unique in the spec; the compiled agent is n_<id>.",
            "pattern": "^[a-z][a-z0-9_]{0,30}$",
            "title": "Id",
            "type": "string"
          },
          "description": {
            "default": "",
            "maxLength": 500,
            "title": "Description",
            "type": "string"
          },
          "kind": {
            "const": "supervisor",
            "title": "Kind",
            "type": "string"
          },
          "instruction": {
            "maxLength": 8000,
            "minLength": 1,
            "title": "Instruction",
            "type": "string"
          },
          "children": {
            "items": {
              "type": "string"
            },
            "maxItems": 10,
            "minItems": 1,
            "title": "Children",
            "type": "array"
          },
          "tools": {
            "items": {
              "type": "string"
            },
            "maxItems": 20,
            "title": "Tools",
            "type": "array"
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Model"
          },
          "output": {
            "anyOf": [
              {
                "$ref": "#/$defs/NodeOutput"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": ["id", "kind", "instruction", "children"],
        "title": "SupervisorNode",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "description": "A composition: nodes, edges, budgets. See the module docstring.",
    "properties": {
      "spec_version": {
        "maximum": 1,
        "minimum": 1,
        "title": "Spec Version",
        "type": "integer"
      },
      "name": {
        "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
        "title": "Name",
        "type": "string"
      },
      "description": {
        "default": "",
        "maxLength": 1000,
        "title": "Description",
        "type": "string"
      },
      "pattern": {
        "default": "pipeline",
        "enum": [
          "pipeline",
          "fan_out_fan_in",
          "router",
          "supervisor",
          "critic_loop",
          "debate",
          "map_reduce",
          "handoff",
          "plan_and_execute"
        ],
        "title": "Pattern",
        "type": "string"
      },
      "budgets": {
        "$ref": "#/$defs/Budgets"
      },
      "nodes": {
        "items": {
          "discriminator": {
            "mapping": {
              "human_approval": "#/$defs/HumanApprovalNode",
              "join": "#/$defs/JoinNode",
              "llm_agent": "#/$defs/LlmAgentNode",
              "parallel": "#/$defs/ParallelNode",
              "remote_a2a": "#/$defs/RemoteA2aNode",
              "router": "#/$defs/RouterNode",
              "supervisor": "#/$defs/SupervisorNode"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/LlmAgentNode"
            },
            {
              "$ref": "#/$defs/RemoteA2aNode"
            },
            {
              "$ref": "#/$defs/RouterNode"
            },
            {
              "$ref": "#/$defs/ParallelNode"
            },
            {
              "$ref": "#/$defs/JoinNode"
            },
            {
              "$ref": "#/$defs/SupervisorNode"
            },
            {
              "$ref": "#/$defs/HumanApprovalNode"
            }
          ]
        },
        "maxItems": 30,
        "minItems": 1,
        "title": "Nodes",
        "type": "array"
      },
      "edges": {
        "items": {
          "$ref": "#/$defs/Edge"
        },
        "maxItems": 90,
        "title": "Edges",
        "type": "array"
      }
    },
    "required": ["spec_version", "name", "nodes"],
    "title": "CompositionSpec",
    "type": "object"
  },
  "events": {
    "$defs": {
      "A2aMessage": {
        "additionalProperties": false,
        "properties": {
          "seq": {
            "default": 0,
            "title": "Seq",
            "type": "integer"
          },
          "run_id": {
            "default": "",
            "title": "Run Id",
            "type": "string"
          },
          "ts": {
            "default": 0.0,
            "title": "Ts",
            "type": "number"
          },
          "type": {
            "const": "a2a.message",
            "default": "a2a.message",
            "title": "Type",
            "type": "string"
          },
          "node_id": {
            "title": "Node Id",
            "type": "string"
          },
          "remote": {
            "title": "Remote",
            "type": "string"
          },
          "skill": {
            "title": "Skill",
            "type": "string"
          },
          "direction": {
            "enum": ["outbound", "inbound"],
            "title": "Direction",
            "type": "string"
          },
          "method": {
            "title": "Method",
            "type": "string"
          },
          "task_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Task Id"
          },
          "context_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Context Id"
          },
          "task_state": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Task State"
          },
          "states": {
            "items": {
              "type": "string"
            },
            "title": "States",
            "type": "array"
          },
          "parts": {
            "items": {
              "$ref": "#/$defs/PartSummary"
            },
            "title": "Parts",
            "type": "array"
          },
          "elapsed_ms": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Elapsed Ms"
          },
          "status": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Status"
          },
          "card_digest": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Card Digest"
          },
          "content": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Content"
          }
        },
        "required": ["node_id", "remote", "skill", "direction", "method"],
        "title": "A2aMessage",
        "type": "object"
      },
      "ApprovalDecided": {
        "additionalProperties": false,
        "properties": {
          "seq": {
            "default": 0,
            "title": "Seq",
            "type": "integer"
          },
          "run_id": {
            "default": "",
            "title": "Run Id",
            "type": "string"
          },
          "ts": {
            "default": 0.0,
            "title": "Ts",
            "type": "number"
          },
          "type": {
            "const": "approval.decided",
            "default": "approval.decided",
            "title": "Type",
            "type": "string"
          },
          "node_id": {
            "title": "Node Id",
            "type": "string"
          },
          "approval_id": {
            "title": "Approval Id",
            "type": "string"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "decision": {
            "enum": ["approved", "rejected", "expired", "cancelled"],
            "title": "Decision",
            "type": "string"
          },
          "waited_ms": {
            "title": "Waited Ms",
            "type": "integer"
          },
          "content": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Content"
          }
        },
        "required": ["node_id", "approval_id", "kind", "decision", "waited_ms"],
        "title": "ApprovalDecided",
        "type": "object"
      },
      "ApprovalRequested": {
        "additionalProperties": false,
        "description": "A run paused for a person's decision (P0c). The text is served apart, to its owner.",
        "properties": {
          "seq": {
            "default": 0,
            "title": "Seq",
            "type": "integer"
          },
          "run_id": {
            "default": "",
            "title": "Run Id",
            "type": "string"
          },
          "ts": {
            "default": 0.0,
            "title": "Ts",
            "type": "number"
          },
          "type": {
            "const": "approval.requested",
            "default": "approval.requested",
            "title": "Type",
            "type": "string"
          },
          "node_id": {
            "title": "Node Id",
            "type": "string"
          },
          "approval_id": {
            "title": "Approval Id",
            "type": "string"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "prompt": {
            "title": "Prompt",
            "type": "string"
          },
          "digest": {
            "title": "Digest",
            "type": "string"
          },
          "size": {
            "title": "Size",
            "type": "integer"
          },
          "expires_at": {
            "title": "Expires At",
            "type": "number"
          },
          "content": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Content"
          }
        },
        "required": ["node_id", "approval_id", "kind", "prompt", "digest", "size", "expires_at"],
        "title": "ApprovalRequested",
        "type": "object"
      },
      "BudgetHit": {
        "additionalProperties": false,
        "properties": {
          "seq": {
            "default": 0,
            "title": "Seq",
            "type": "integer"
          },
          "run_id": {
            "default": "",
            "title": "Run Id",
            "type": "string"
          },
          "ts": {
            "default": 0.0,
            "title": "Ts",
            "type": "number"
          },
          "type": {
            "const": "budget.hit",
            "default": "budget.hit",
            "title": "Type",
            "type": "string"
          },
          "budget": {
            "enum": [
              "max_tokens",
              "max_tool_calls",
              "max_delegations",
              "max_remote_calls",
              "timeout_s"
            ],
            "title": "Budget",
            "type": "string"
          },
          "limit": {
            "title": "Limit",
            "type": "integer"
          },
          "used": {
            "title": "Used",
            "type": "integer"
          }
        },
        "required": ["budget", "limit", "used"],
        "title": "BudgetHit",
        "type": "object"
      },
      "LoopIteration": {
        "additionalProperties": false,
        "description": "A loop edge was taken (``stopped=False``) or refused at its cap (``stopped=True``).",
        "properties": {
          "seq": {
            "default": 0,
            "title": "Seq",
            "type": "integer"
          },
          "run_id": {
            "default": "",
            "title": "Run Id",
            "type": "string"
          },
          "ts": {
            "default": 0.0,
            "title": "Ts",
            "type": "number"
          },
          "type": {
            "const": "loop.iteration",
            "default": "loop.iteration",
            "title": "Type",
            "type": "string"
          },
          "edge": {
            "title": "Edge",
            "type": "string"
          },
          "from_node": {
            "title": "From Node",
            "type": "string"
          },
          "to_node": {
            "title": "To Node",
            "type": "string"
          },
          "iteration": {
            "title": "Iteration",
            "type": "integer"
          },
          "cap": {
            "title": "Cap",
            "type": "integer"
          },
          "stopped": {
            "default": false,
            "title": "Stopped",
            "type": "boolean"
          }
        },
        "required": ["edge", "from_node", "to_node", "iteration", "cap"],
        "title": "LoopIteration",
        "type": "object"
      },
      "McpCall": {
        "additionalProperties": false,
        "properties": {
          "seq": {
            "default": 0,
            "title": "Seq",
            "type": "integer"
          },
          "run_id": {
            "default": "",
            "title": "Run Id",
            "type": "string"
          },
          "ts": {
            "default": 0.0,
            "title": "Ts",
            "type": "number"
          },
          "type": {
            "const": "mcp.call",
            "default": "mcp.call",
            "title": "Type",
            "type": "string"
          },
          "node_id": {
            "title": "Node Id",
            "type": "string"
          },
          "entry": {
            "title": "Entry",
            "type": "string"
          },
          "tool": {
            "title": "Tool",
            "type": "string"
          },
          "classification": {
            "title": "Classification",
            "type": "string"
          },
          "outcome": {
            "title": "Outcome",
            "type": "string"
          },
          "status": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Status"
          },
          "elapsed_ms": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Elapsed Ms"
          }
        },
        "required": ["node_id", "entry", "tool", "classification", "outcome"],
        "title": "McpCall",
        "type": "object"
      },
      "NodeEnter": {
        "additionalProperties": false,
        "properties": {
          "seq": {
            "default": 0,
            "title": "Seq",
            "type": "integer"
          },
          "run_id": {
            "default": "",
            "title": "Run Id",
            "type": "string"
          },
          "ts": {
